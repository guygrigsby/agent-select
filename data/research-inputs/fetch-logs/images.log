import urllib.request, json, time, os

headers = {'User-Agent': 'agent-routing-research/0.1'}
sources = []

# BFL - Black Forest Labs models
urls = {
    'bfl_flux2_announcement': 'https://blackforestlabs.ai/flux-2/',
    'bfl_kontext': 'https://blackforestlabs.ai/flux-kontext/',
    'bfl_github': 'https://github.com/black-forest-labs/flux',
    'bfl_hf': 'https://huggingface.co/black-forest-labs',
}

for name, url in urls.items():
    try:
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=40) as resp:
            body = resp.read()
            fname = f'data/research/images/sources/{name}.html'
            with open(fname, 'wb') as f:
                f.write(body)
            sources.append({'url': url, 'file': fname, 'status': 'retrieved', 'size': len(body)})
        time.sleep(1.1)
    except urllib.error.HTTPError as e:
        sources.append({'url': url, 'file': '', 'status': f'blocked_{e.code}', 'error': str(e)})
    except Exception as e:
        sources.append({'url': url, 'file': '', 'status': 'not_found', 'error': str(e)})
        
print(json.dumps(sources, indent=2))
