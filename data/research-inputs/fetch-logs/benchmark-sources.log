### 19
cd /Users/guygrigsby/projects/agent-routing/data/research/benchmark-sources

# HELM - find the data API by looking at their React app
curl -s -L --max-time 40 \
  -H "User-Agent: agent-routing-research/0.1" \
  "https://crfm.stanford.edu/helm/classic/" -o _helm_classic_full.html 2>&1 || echo "FAILED"

# Check for API endpoints in the page
python3 -c "
import re
with open('_helm_classic_full.html') as f:
    content = f.read()
print('Length:', len(content))
# Look for data URLs
urls = re.findall(r'https?://[^\"\\\'\\s<>)]+', content)
for u in urls:
    if any(x in u.lower() for x in ['api', 'data', 'json', 'leaderboard', 'benchmark', 'result', 'csv']):
        print(u)
# Also look for fetch/ajax references
refs = re.findall(r'(?:fetch|axios|\.get|\.post|url|api)[^;]{0,300}', content, re.I)
for r in refs[:20]:
    if 'leaderboard' in r.lower() or 'result' in r.lower() or 'benchmark' in r.lower() or 'data' in r.lower():
        print('Ref:', r[:150])
"
