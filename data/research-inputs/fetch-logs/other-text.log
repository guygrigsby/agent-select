import urllib.request, urllib.error, json, time, os, sys
from urllib.parse import urlparse

sources_dir = "data/research/other-text/sources"

def fetch(url, filename, purpose):
    """Fetch a URL with retry handling"""
    path = os.path.join(sources_dir, filename)
    req = urllib.request.Request(url)
    req.add_header('User-Agent', 'agent-routing-research/0.1')
    try:
        with urllib.request.urlopen(req, timeout=40) as resp:
            content = resp.read()
            with open(path, 'wb') as f:
                f.write(content)
            print(f"OK  {url} -> {filename} ({len(content)} bytes)")
            return {"url": url, "file": f"data/research/other-text/sources/{filename}", "status": "retrieved", "purpose": purpose, "license": "unknown"}
    except urllib.error.HTTPError as e:
        print(f"ERR {url} -> HTTP {e.code}")
        return {"url": url, "file": f"data/research/other-text/sources/{filename}", "status": "not_found" if e.code == 404 else "blocked", "purpose": purpose, "license": "unknown"}
    except Exception as e:
        print(f"ERR {url} -> {e}")
        return {"url": url, "file": f"data/research/other-text/sources/{filename}", "status": "blocked", "purpose": purpose, "license": "unknown"}

# Fetch concurrent sources for multiple providers
urls = [
    # NVIDIA Nemotron - Hugging Face model cards
    ("https://huggingface.co/nvidia/Nemotron-3-Nano-30B-A3B/raw/main/README.md", "nvidia-nemotron-3-nano-readme.md", "NVIDIA Nemotron 3 Nano model card"),
    ("https://huggingface.co/nvidia/Nemotron-3-Super-120B-A12B/raw/main/README.md", "nvidia-nemotron-3-super-readme.md", "NVIDIA Nemotron 3 Super model card"),
    ("https://build.nvidia.com/nvidia/nemotron-3-super-120b-a12b/modelcard", "nvidia-nemotron-3-super-build.md", "NVIDIA Nemotron 3 Super build page"),
    # Cohere Command-A
    ("https://docs.cohere.com/docs/command-a", "cohere-command-a-docs.md", "Cohere Command-A documentation"),
    # StepFun
    ("https://huggingface.co/stepfun-ai/Step-3.5-Flash/raw/main/README.md", "stepfun-step-3.5-flash-readme.md", "StepFun Step 3.5 Flash model card"),
    ("https://huggingface.co/stepfun-ai/Step-3.7-Flash/raw/main/README.md", "stepfun-step-3.7-flash-readme.md", "StepFun Step 3.7 Flash model card"),
    ("https://huggingface.co/stepfun-ai/Step-5-Preview/raw/main/README.md", "stepfun-step-5-preview-readme.md", "StepFun Step 5 Preview model card"),
    # Amazon Nova
    ("https://docs.aws.amazon.com/nova/latest/userguide/what-is-nova.html", "amazon-nova-overview.md", "Amazon Nova overview"),
    # Tencent Hunyuan
    ("https://huggingface.co/Tencent/Hunyuan3-1-MoE-A3B/raw/main/README.md", "tencent-hunyuan3-readme.md", "Tencent Hunyuan3 MoE model card"),
    # Inclusion AI
    ("https://huggingface.co/inclusionai/Ling-3.0-Flash/raw/main/README.md", "inclusionai-ling-3.0-flash-readme.md", "InclusionAI Ling 3.0 Flash model card"),
    # Xiaomi MiMo
    ("https://huggingface.co/xiaomi-ai/MiMo-V2.5-Pro/raw/main/README.md", "xiaomi-mimo-v2.5-pro-readme.md", "Xiaomi MiMo V2.5 Pro model card"),
    # Arcee AI
    ("https://huggingface.co/arcee-ai/Trinity-Large-Thinking/raw/main/README.md", "arcee-trinity-large-thinking-readme.md", "Arcee AI Trinity Large Thinking model card"),
]

results = []
for url, filename, purpose in urls:
    results.append(fetch(url, filename, purpose))
    time.sleep(1)

print("\n--- Summary ---")
for r in results:
    print(f"{r['status']}: {r['url']}")
